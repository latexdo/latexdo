{
  "name": "latexdo",
  "version": "0.3.0",
  "private": true,
  "description": "A focused desktop LaTeX editor with live PDF preview.",
  "author": "LatexDo",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite --host 127.0.0.1",
    "collab:start": "node collaborations/server.mjs",
    "collab:check": "node --check collaborations/server.mjs",
    "ai:sync": "node scripts/sync-ai.mjs",
    "build": "npm run ai:sync && tsc -b && vite build && node scripts/verify-built-assets.mjs && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "sync:downstream": "sh scripts/sync-downstream-repos.sh",
    "typecheck": "npm run ai:sync && tsc -b --pretty false && tsc -p tsconfig.electron.json --pretty false",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:diagnostics": "node --experimental-strip-types scripts/test-latex-diagnostics.ts",
    "test:supply-chain": "node scripts/verify-supply-chain.mjs && node scripts/test-supply-chain-runtime.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bibtex-parse": "2.1.0",
    "lib0": "^0.2.117",
    "lucide-react": "^0.468.0",
    "mathjax-full": "^3.2.1",
    "monaco-editor": "^0.52.2",
    "node-llama-cpp": "^3.7.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "y-indexeddb": "^9.0.12",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "9.2.4",
    "cross-env": "^7.0.3",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.0.5",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6",
    "brace-expansion": "5.0.8",
    "dir-compare": "5.0.0",
    "electron-winstaller": "5.4.4",
    "filelist": "2.0.2",
    "glob": "13.0.2",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "tar": "7.5.22"
  },
  "build": {
    "appId": "com.latexdo.editor",
    "productName": "LatexDo",
    "icon": "build/icon.png",
    "npmRebuild": true,
    "asarUnpack": [
      "**/node_modules/node-llama-cpp/**",
      "**/node_modules/@node-llama-cpp/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/update-public-key.pem",
        "to": "update-public-key.pem"
      },
      {
        "from": "examples/welcome",
        "to": "examples/welcome"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "LatexDo needs access to open and save LaTeX projects in your Documents folder.",
        "NSDownloadsFolderUsageDescription": "LatexDo needs access to export generated PDFs and project files to Downloads."
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage"
      ]
    }
  }
}
