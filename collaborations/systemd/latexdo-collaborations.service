[Unit]
Description=LatexDo collaboration backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=latexdo
Group=latexdo
WorkingDirectory=/opt/latexdo
EnvironmentFile=/etc/latexdo/collaborations.env
ExecStart=/usr/bin/node /opt/latexdo/collaborations/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/latexdo-collaborations
ReadWritePaths=/var/log/latexdo-collaborations

[Install]
WantedBy=multi-user.target
